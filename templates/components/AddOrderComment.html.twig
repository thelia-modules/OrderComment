<div {{ attributes }}>
    {% set orderCommentContent %}
        {{ form_start(form, {
            attr: {
                class: 'flex flex-col gap-4 mt-4',
                'data-controller': 'live',
                'data-live-id': live_id,
                'data-action': 'submit->live#action',
                'data-live-action-param': 'save'
            }
        }) }}

        {{ form_rest(form) }}

        {{ form_end(form) }}
    {% endset %}

    {{ orderCommentContent }}
</div>
